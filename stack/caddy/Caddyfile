{
	# after request_header so the client Cache-Control/Pragma strip below runs first;
	# still ahead of encode, so the store holds uncompressed bodies (verified).
	order cache after request_header
	cache {
		# Only responses that SAY they are shared-cacheable are stored (the app's
		# middleware sets `public, s-maxage=...` on anonymous pages, see
		# apps/blog/lib/anonymous-cache-policy.ts). Everything else stays no-store.
		default_cache_control no-store
		# Otter: a bounded in-memory store (the module's default map store is
		# documented as development-only and unbounded). The count bound times
		# the size bound must stay under the container's 1.5 GB limit: 600
		# entries at up to 1 MB each (bodies are stored uncompressed; the heaviest
		# real profile measured 1.24 MB and simply is not stored). That is still
		# the whole hot set: home, topics, popular profiles and posts.
		otter {
			configuration {
				size 600
			}
		}
		ttl 300s
		stale 60s
		key {
			disable_host
			headers X-Lumen-Locale
		}
		max_cacheable_body_bytes 1000000
		log_level info
	}
}

lumensocial.net, www.lumensocial.net {
	encode zstd gzip

	# ★★★ CRAWLERS THAT TAKE WITHOUT GIVING ARE REFUSED AT THE EDGE (2026-09-06,
	# owner ruling: "I dont want anything to compete with responsiveness or my
	# readers"). Measured before this went in: 168,866 edge requests in 24h, 83 to
	# 92 percent bots, and meta-webindexer ALONE was 46.7 percent, 85,024 requests,
	# which had never once fetched robots.txt and was hitting paths disallowed
	# since 09-02. Every one of those cost a full render AND the upstream Hive
	# calls behind it, for a page no human reads, competing for the same Hive
	# quota readers wait on (648 rate-limit failovers a day).
	#
	# KEPT ON PURPOSE, do not add these to the list:
	#   Googlebot        the only crawler that demonstrably sends readers
	#   the unfurlers    facebookexternalhit, Twitterbot, Discordbot, Slackbot,
	#                    TelegramBot, WhatsApp, LinkedInBot, redditbot, Embedly,
	#                    Iframely, Mastodon. These fire because a HUMAN shared a
	#                    link, and blocking them breaks how that link looks.
	# Applebot is blocked by explicit owner instruction (2026-09-06), which also
	# costs Siri and Spotlight results. Reverse by removing it from the list.
	#
	# Reverting the whole thing: restore Caddyfile.before-botblock-2026-09-06 and
	# reload. No deploy, no restart, seconds.
	# ★★★ 2026-09-16, owner ruling: "block all crawlers except the google
	# one". THE LIST ABOVE FLIPPED FROM A DENYLIST TO AN ALLOWLIST.
	#
	# The 09-06 denylist worked: meta-webindexer went from 46.7 percent of all
	# traffic to ZERO hits, verified in /var/log/lumen.log. But a denylist only
	# stops names already on it. By 09-15 the two largest crawlers were
	# ShapBot/0.1.0 (587 hits) and Claude-SearchBot/1.0 (124), neither on the
	# list, both served 200. Traffic was still ~92 percent bots, and the Hive
	# quota they compete for was being rate limited: 3 of 25 probe calls to
	# api.openhive.network came back 429 from this box while the same probe from
	# a home connection got 25 of 25.
	#
	# The rule is now the other way round: anything whose User-Agent identifies
	# it as a crawler is refused UNLESS it is on the keep list below. A crawler
	# invented tomorrow is blocked on arrival with no edit here.
	#
	# KEPT, and why:
	#   Googlebot              the only crawler that demonstrably sends readers
	#   Google-InspectionTool  Search Console live test, same account as above
	#   the unfurlers          facebookexternalhit, Twitterbot, Discordbot,
	#                          Slackbot, TelegramBot, WhatsApp, LinkedInBot,
	#                          redditbot, Embedly, Iframely, Mastodon, Pleroma,
	#                          Misskey, Bluesky. These fire because a HUMAN
	#                          shared a link. Blocking them breaks how that link
	#                          looks. They are not crawlers.
	#   CUBOT                  ★ A PHONE BRAND, NOT A BOT. Its UA carries the
	#                          literal string "bot" (CUBOT NOTE 20), so a bare
	#                          "bot" match would refuse a real reader holding
	#                          one. This is the one known false positive of
	#                          matching "bot" as a substring, and matching it as
	#                          a substring is not optional: Googlebot, bingbot,
	#                          ShapBot and ClaudeBot all carry it mid-word too.
	#
	# Google-Extended and GoogleOther are deliberately NOT kept. They are
	# Google AI-training and other-product fetchers, which take without sending
	# readers, and that is the whole test this rule applies.
	#
	# ★ A request with NO User-Agent at all matches neither half and is still
	# served. Left that way on purpose: some real clients send none, and the
	# in-app crawler budget (lib/request-budget.ts) already covers that case.
	#
	# Reverting: restore Caddyfile.before-botallowlist-2026-09-16 for this rule
	# alone, or Caddyfile.before-botblock-2026-09-06 to remove edge bot blocking
	# entirely, then reload. No deploy, no restart, seconds.
	@blockedbots {
	# ★★ THE NAMED LIST IS BACK, AHEAD OF THE GENERIC ONE (2026-09-16, owner:
	# "add those two bots in the blacklist as well"). ShapBot and Claude-SearchBot
	# are now named outright, and so is every name the 09-06 denylist carried.
	#
	# ★ THIS IS NOT BELT-AND-BRACES, IT CLOSED A REAL HOLE I OPENED. Replacing
	# the named list with a generic "looks like a crawler" pattern quietly lost the
	# two names that contain no crawler word at all:
	#     Barkrowler        "rowler", not "crawler"        -> was being served 200
	#     Screaming.Frog    only caught while its UA still said "SEO Spider";
	#                       "Screaming Frog SEO" alone     -> was being served 200
	# Both verified 200 against the origin before this line went in, and 403 after.
	# THE LESSON: a generic pattern is a floor, not a replacement. Any name that
	# does not spell out what it is has to stay written down.
		header_regexp botua User-Agent (?i)(ShapBot|Claude-SearchBot|meta-webindexer|meta-externalagent|FacebookBot|ClaudeBot|anthropic-ai|GPTBot|OAI-SearchBot|ChatGPT-User|CCBot|Bytespider|Amazonbot|Applebot|PerplexityBot|YouBot|Diffbot|omgili|ImagesiftBot|Timpibot|cohere-ai|DataForSeoBot|AhrefsBot|SemrushBot|MJ12bot|DotBot|Barkrowler|SeekportBot|serpstatbot|ZoominfoBot|bingbot|BLEXBot|PetalBot|YandexBot|SeznamBot|Sogou|Exabot|magpie-crawler|TurnitinBot|Screaming.Frog|Google-Extended|GoogleOther|bot|crawler|crawling|spider|scraper|scraping|indexer|slurp|archiver|feedfetcher)
		not header_regexp keepua User-Agent (?i)(Googlebot|Google-InspectionTool|facebookexternalhit|Twitterbot|Discordbot|Slackbot|Slack-ImgProxy|TelegramBot|WhatsApp|LinkedInBot|redditbot|Embedly|Iframely|Mastodon|Pleroma|Misskey|Akkoma|Friendica|Bluesky|Pinterest|SkypeUriPreview|vkShare|CUBOT)
	}
	handle @blockedbots {
		respond "Not served to automated indexers. Contact the site owner." 403 {
			close
		}
	}

	# DATACENTER CRAWL, BLOCKED BY NETWORK, NOT BY NAME (2026-09-23, owner: "if theyre
	# useless and screw our page we blacklist or is there a better way"). The name list above
	# only catches clients that say what they are. This crawl sent ordinary Chrome user agents
	# from 1,500+ addresses, so it matched no name and stayed under every per-IP budget: in the
	# hour before this rule, 4,692 of 5,104 page views came from two rented-server networks,
	# Alibaba Cloud (47.74.0.0-47.87.255.255, ARIN AL-3) and OVH VPS (141.94.0.0/15,
	# VPS-EU-WEST-RBX), crawling 2017-2018 posts. Each render called the Hive nodes several
	# times; the nodes refused (1,493 failures in that hour) and real readers waited on retries.
	# People do not browse from these server ranges. Page routes only: /api and static files
	# are untouched. The address is the Cf-Connecting-Ip header set by Cloudflare.
	# Reverting: restore Caddyfile.before-dcblock-2026-09-23 and reload.
	@datacentercrawl {
		header_regexp dcip Cf-Connecting-Ip ^(47\.(7[4-9]|8[0-7])\.|141\.9[45]\.)
		not path /api/* /_next/* /favicon.ico /robots.txt /site.webmanifest
		# Link-preview fetchers stay allowed even from these networks: a self-hosted
		# Mastodon/Pleroma server can live on an OVH VPS. Googlebot is deliberately NOT in
		# this list: the real one never comes from Alibaba Cloud or OVH, so a "Googlebot"
		# from here is a spoof. (Checked 09-21..23: no preview bot came from these ranges.)
		not header_regexp dckeep User-Agent (?i)(facebookexternalhit|Twitterbot|Discordbot|Slackbot|Slack-ImgProxy|TelegramBot|WhatsApp|LinkedInBot|redditbot|Embedly|Iframely|Mastodon|Pleroma|Misskey|Akkoma|Friendica|Bluesky|Pinterest|SkypeUriPreview|vkShare)
	}
	handle @datacentercrawl {
		respond "Not served to automated clients from this network. Contact the site owner." 403 {
			close
		}
	}

	# The app reads the client address from the RIGHTMOST X-Forwarded-For entry
	# our own edge appended (LITE_TRUSTED_PROXY_COUNT). Caddy appends, so with
	# Caddy alone that count is 1. When Cloudflare proxying (orange cloud) is
	# turned on it becomes 2, and that setting MUST change at the same time:
	# too low and every visitor behind the proxy shares one rate-limit bucket,
	# too high and a caller can forge a fresh bucket per request.

	# ★ Snappiness phase 2 (2026-09-02): anonymous HTML from the cache.
	# The cache key varies on the reader's locale cookie (rendered into a
	# header here, so the key never contains the whole Cookie header). Bypassed
	# outright for signed-in readers (session cookie), for router navigations
	# (RSC flight requests, whose payload depends on client state), and for our
	# own QA checks (header), so those always reach the app.
	# Locale into a header for the cache key: the default FIRST (this also
	# discards any X-Lumen-Locale a client sent, so nobody can mint keys), then
	# the cookie value, accepted only when it is one of the app's nine
	# languages (an arbitrary cookie value would otherwise be a fresh key each).
	# Both branches carry a matcher on purpose: Caddy orders same-directive
	# handlers by matcher, not by line, so an unmatched default would run last
	# and overwrite the cookie value (found on the staged proxy).
	# Anchored at a cookie boundary: an unanchored match let `junk=NEXT_LOCALE=en;
	# NEXT_LOCALE=pl` store a Polish page under the English key (found in review).
	@haslocale header_regexp locale Cookie (^|;\s*)NEXT_LOCALE=(ar|en|es|fr|it|ja|pl|ru|zh)(;|$)
	@nolocale not header_regexp Cookie (^|;\s*)NEXT_LOCALE=
	request_header @haslocale X-Lumen-Locale {re.locale.2}
	request_header @nolocale X-Lumen-Locale en
	# A locale cookie in ANY other spelling (`pl-PL`, `%61r`, upper case ...) is
	# honoured by the app but not by the key above, so it would be stored under
	# `en` and served to everyone (found in review round 2, on the live edge).
	# Such requests never touch the cache at all.
	@oddlocale {
		header_regexp Cookie (^|;\s*)NEXT_LOCALE=
		not header_regexp Cookie (^|;\s*)NEXT_LOCALE=(ar|en|es|fr|it|ja|pl|ru|zh)(;|$)
	}

	# Any sealed session cookie whatever its APP_NAME prefix (`app_session`,
	# `blog_session`, ...), the client-set `observer`, `account_info`, and HEAD
	# requests (which would otherwise get a key of their own and always miss).
	@bypass {
		header_regexp Cookie (^|;\s*)([A-Za-z0-9_-]*_)?(session|observer|account_info)=
	}
	@head method HEAD
	@rsc header RSC 1
	@rscq query _rsc=*
	@qa header X-Lumen-Qa *
	@api path /api/* /_next/* /oidc/* /.well-known/*

	handle @bypass {
		reverse_proxy 127.0.0.1:3000
	}
	handle @oddlocale {
		reverse_proxy 127.0.0.1:3000
	}
	handle @rsc {
		reverse_proxy 127.0.0.1:3000
	}
	handle @rscq {
		reverse_proxy 127.0.0.1:3000
	}
	handle @qa {
		reverse_proxy 127.0.0.1:3000
	}
	handle @api {
		reverse_proxy 127.0.0.1:3000
	}
	# A HEAD on a page costs the origin a full render (86 of 476 renders in a
	# 15-minute window were crawler HEADs). Pages answer HEAD at the edge with
	# an empty 200; API HEADs still reach the app (matched earlier by @api).
	handle @head {
		respond 200
	}
	handle {
		# A client's own Cache-Control/Pragma must not be able to force an origin
		# render (the primitive behind every poisoning attempt found in review).
		request_header -Cache-Control
		request_header -Pragma
		# The app sends no validators, so a client's If-Modified-Since only ever
		# meant "revalidate at the origin"; same primitive, same treatment.
		request_header -If-None-Match
		request_header -If-Modified-Since
		# ★★★ NO `cache` DIRECTIVE HERE ANY MORE (2026-09-08). DO NOT PUT IT BACK
		# WITHOUT READING THIS.
		#
		# The Souin `cache` directive used to sit on this line. It BUFFERS THE WHOLE
		# RESPONSE: to decide what to store it reads the body to the end before
		# forwarding any of it, so the origin's progressive render was withheld from
		# the reader until it had completely finished. Node emits the profile shell
		# at p50 175 ms and finishes at p50 636 ms; with the cache in front, the
		# reader saw nothing until the end.
		#
		# Isolated to this directive specifically, one variable at a time against a
		# controlled upstream that flushes every 100 ms: bare reverse_proxy streams
		# (spread ~1130 ms), `handle_response`/`copy_response` below streams
		# (~1060 ms, so it is NOT the cause), `cache` alone buffers (spread 0 ms).
		#
		# WHY GIVING IT UP IS CHEAP. It was serving 4.2 % of eligible responses
		# (259 HIT of 6,213 in the access log) because CLOUDFLARE NOW CACHES
		# ANONYMOUS HTML ITSELF and absorbs the repeats — verified MISS-then-HIT
		# with an Age header on /@ecency and /@blocktrades. That is the opposite of
		# what SNAPPINESS-AUDIT-2026-09-02.md assumed when this cache was chosen
		# ("Cloudflare does NOT cache HTML ... a HIT on HTML is the bug"); the
		# premise changed, so the decision changed. So it was buffering 100 % of
		# responses to serve 4.2 % of them.
		#
		# MEASURED ON PRODUCTION, cold never-visited profiles: TTFB 824 -> 386 ms,
		# document delivery spread 52 -> 552 ms (i.e. streaming restored). On an
		# A/B of two identical Caddy instances differing only in this line, total
		# render time was UNCHANGED (656 vs 676 ms, CI spanning zero) — the origin
		# was never made faster, the edge simply stopped withholding finished work.
		# Through Cloudflare, first paint improved 706 ms (p=0.0067). It does NOT
		# improve LCP (-100 ms, p=0.65); that is bound by the origin finishing.
		#
		# The global `cache { ... }` block and `order cache after request_header`
		# are LEFT IN PLACE on purpose: with no directive invoking them they are
		# inert, and keeping them makes restoring this a one-line revert.
		#
		# ★ IF YOU EDIT THIS FILE, RESTART THE CONTAINER, DO NOT JUST RELOAD.
		# Docker bind-mounts a single file BY INODE and `sed -i` writes a new one,
		# so the container goes on serving the old config and `caddy reload`
		# reports success while changing nothing. That false success was hit once
		# already. Verify with:
		#   md5sum /opt/lumen/caddy/Caddyfile
		#   docker exec lumen-caddy md5sum /etc/caddy/Caddyfile
		reverse_proxy 127.0.0.1:3000 {
			# The app sets its cache policy before it knows the status, so a 404
			# (any /@name that does not exist) would be stored for 300 s and
			# a thousand made-up names would evict the whole hot set. Not stored.
			@notok status 404 410 500 502 503
			handle_response @notok {
				header Cache-Control "private, no-store"
				copy_response
			}
		}
	}

	log {
		output file /data/access.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}
}
