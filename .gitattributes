# Normalize all text to LF in the repo (WSL + Windows O: drive mix).
# Prevents "whole file changed" CRLF noise and keeps diffs clean.
* text=auto eol=lf

*.go    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Windows-only scripts keep CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Treat these as binary (never touch line endings / never diff)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.wasm  binary
*.pdf   binary
