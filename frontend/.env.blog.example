# Denser Blog Environment Configuration
# Copy to ~/.denser/.env.blog and fill in secrets
#
# IMPORTANT: Secrets (SECRET_COOKIE_PASSWORD, OIDC_COOKIES_KEYS) should be
# different from wallet for defense in depth. Generate unique values for each.

# =============================================================================
# App Identity (MUST differ between blog and wallet)
# =============================================================================
REACT_APP_APP_NAME="blog"
REACT_APP_SITE_DOMAIN="https://blog.openhive.network"
REACT_APP_APP_SESSION_TIME=64800

## Note: Those are the default Hive API nodes, you can modify them as needed.
## If you do not provide this variable, those default nodes will be used as a fallback. List is space & comma separated.
REACT_APP_ALLOWED_HIVE_API_NODES="https://api.hive.blog https://api.syncad.com https://api.openhive.network https://images.hive.blog"

# =============================================================================
# Hive Blockchain
# =============================================================================
REACT_APP_API_ENDPOINT="https://api.hive.blog"
REACT_APP_CHAIN_ID="beeab0de00000000000000000000000000000000000000000000000000000000"
# Base URL for image proxy service (no trailing slash)
REACT_APP_IMAGES_ENDPOINT="https://images.hive.blog"

# =============================================================================
# Related Services
# =============================================================================
REACT_APP_WALLET_ENDPOINT="https://wallet.openhive.network"
REACT_APP_BLOG_DOMAIN="https://blog.openhive.network"
REACT_APP_EXPLORER_DOMAIN="https://explore.openhive.network"
REACT_APP_AI_DOMAIN="https://api.syncad.com"

# =============================================================================
# Authentication
# =============================================================================
REACT_APP_ALLOW_NON_STRICT_LOGIN="yes"
REACT_APP_LOGIN_AUTHENTICATE_ON_BACKEND="no"

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=production
DENSER_SERVER_ENV_DUMP=false
DENSER_SERVER_API_CORS_ALLOW_ORIGIN="false"

# REQUIRED: Generate with: openssl rand -base64 32
# Must be unique - do not share with wallet
DENSER_SERVER_SECRET_COOKIE_PASSWORD="CHANGE_ME_GENERATE_UNIQUE_SECRET"

# =============================================================================
# OIDC (OpenID Connect)
# =============================================================================
DENSER_SERVER_OIDC_ENABLED="yes"

# REQUIRED: Generate with: openssl rand -base64 32
# Must be unique - do not share with wallet
DENSER_SERVER_OIDC_COOKIES_KEYS="CHANGE_ME_GENERATE_UNIQUE_SECRET"

# =============================================================================
# OpenHive Chat Integration (Rocket.Chat Widget)
# =============================================================================
# The chat widget appears as a floating button (lower-right) for logged-in users.
# Users must have granted OAuth consent to openhive_chat to see the widget.

REACT_APP_OPENHIVE_CHAT_CLIENT_ID="openhive_chat"
REACT_APP_OPENHIVE_CHAT_API_URI="https://openhive.chat/api/v1"
REACT_APP_OPENHIVE_CHAT_URI="https://openhive.chat"

# Enable the embedded chat iframe widget ("yes" to enable, "no" to disable)
REACT_APP_OPENHIVE_CHAT_IFRAME_INTEGRATION_ENABLE="no"

# Show/hide the widget even when enabled (for debugging)
REACT_APP_OPENHIVE_CHAT_IFRAME_VISIBLE="yes"

# Allow non-strict login (HiveAuth, etc.) users to access chat
REACT_APP_OPENHIVE_CHAT_ALLOW_NON_STRICT_LOGIN="no"

# Comma-separated list of usernames allowed to see chat widget (empty = all users)
# Use for gradual rollout: REACT_APP_OPENHIVE_CHAT_ALLOWED_USERS="gandalf,gtg,user3"
REACT_APP_OPENHIVE_CHAT_ALLOWED_USERS=""

# GLOBAL AUTHOR BAN LIST — chain accounts Lumen refuses to render, anywhere.
# Read by packages/ui/config/lists/banned-authors.ts (see that file's own doc for
# why this is env rather than a committed array, and why it must be readable in
# the BROWSER as well as on the server — several surfaces call a public Hive node
# directly from the client, with our server nowhere in the request path).
#
# ★ THIS MUST BE SET IN EVERY DEPLOYED ENVIRONMENT. There is no committed default
# list of names anywhere in the repo, so an environment that omits this variable
# renders every banned account normally. Documented here on 2026-08-11 after the
# bpcvoter ring was added to a local .env.local only — which does not travel
# with a commit, so the ban would have shipped as nothing.
#
# ★ 2026-08-12: omitting this now logs a loud `console.error` from
# `packages/ui/config/lists/banned-authors.ts` the first time the list is
# resolved (server AND browser — check both). It does not stop the server from
# starting; see that file's `warnBanListEmpty` for why a hard boot refusal was
# considered and rejected.
#
# Names may be written with or without a leading @, separated by commas and/or
# spaces. bpcvoter1/2/3 are the -8 to -13 reputation spam ring (bpcvoter1 alone
# appeared 15 times in a single comment thread); bpcvoter4 has one post and
# neutral reputation; the bare `bpcvoter` has POSITIVE reputation (38.4) and is
# bpcvoter1's on-chain recovery_account — it is included because it matches the
# ring, but it is the one entry worth a second opinion before shipping.
REACT_APP_BANNED_AUTHORS="kgakakillerg, bpcvoter, bpcvoter1, bpcvoter2, bpcvoter3, bpcvoter4"

# REQUIRED: Rocket.Chat admin credentials for token generation
# Get these from OpenHive Chat admin panel
DENSER_SERVER_OPENHIVE_CHAT_ADMIN_USER_ID="CHANGE_ME_ADMIN_USER_ID"
DENSER_SERVER_OPENHIVE_CHAT_ADMIN_USER_TOKEN="CHANGE_ME_ADMIN_USER_TOKEN"

# Secret for users.createToken API (required for RC 8.0.0+)
# Must match CREATE_TOKENS_FOR_USERS_SECRET env var on Rocket.Chat server
DENSER_SERVER_OPENHIVE_CHAT_CREATE_TOKEN_SECRET=""

# Enable auto-creation of Rocket.Chat users when they don't exist ("yes" or "no")
DENSER_SERVER_OPENHIVE_CHAT_IFRAME_CREATE_USERS="no"

# OAuth2 client secret for OpenHive Chat SSO
# Generate with: openssl rand -base64 32
# Must match the secret configured in Rocket.Chat OAuth settings
DENSER_SERVER_OAUTH_OPENHIVE_CHAT_SECRET="CHANGE_ME_GENERATE_UNIQUE_SECRET"

# =============================================================================
# Logging & Debugging
# =============================================================================
# For production, consider changing to: info/false/errors
REACT_APP_LOGGING_LOG_LEVEL="debug"
DEBUG_API_CALLS=true
DEBUG_API_LEVEL=all
DEBUG_API_SLOW_THRESHOLD=1000

# =============================================================================
# Google Drive Integration
# =============================================================================
REACT_APP_GOOGLE_DRIVE_CLIENT_ID=1000000000000-xxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxx-xxxxxxxxxxx

# =============================================================================
# MetaMask Snap Configuration
# =============================================================================
# REACT_APP_METAMASK_SNAP_VERSION=1.7.0
# REACT_APP_METAMASK_SNAP_LOCATION=local:http://localhost:8080 # For local development

# =============================================================================
# Sentry Error Tracking - leave empty to disable
# =============================================================================
REACT_APP_SENTRY_DSN=
SENTRY_AUTH_TOKEN=sntrys_ey...

# SECURITY: Set to 'true' only for local development debugging.
# Leave 'false' for staging/production to avoid PII collection.
# When true, Sentry captures IP addresses, cookies, and HTTP headers.
REACT_APP_SENTRY_SEND_PII=false

# =============================================================================
# Creator Tokens — UNPROVISIONED ON PURPOSE (2026-07-28)
# =============================================================================
# Nothing is deployed yet. With CONTRACT_ID/NET_ID/GQL_URL unset,
# getCreatorTokensDataSource() returns null and every creator-token surface
# renders an explicit "not available yet". That is the intended default.
#
# Until 2026-07-28 the selector silently fell back to an in-memory MOCK when
# these were missing, so every build in every environment served fabricated
# markets and balances and nothing said so. Do not restore that by filling
# these with placeholder values: a partial config is treated as unconfigured,
# and a WRONG config is worse than none.
#
# All three are required together; fill them after a real testnet deploy.
# REACT_APP_CREATOR_TOKENS_CONTRACT_ID=
# REACT_APP_CREATOR_TOKENS_NET_ID=
# REACT_APP_CREATOR_TOKENS_GQL_URL=
# Optional: the indexer REST base (wallet / my-asks / delivery-record reads).
# Leave unset until the indexer actually serves HTTP — it does not yet.
# REACT_APP_CREATOR_TOKENS_INDEXER_URL=
# Optional: rc_limit per op. Default 1000. RC on Magi is sized by HBD HELD, so
# a high value demands the user keep that much HBD idle.
# REACT_APP_CREATOR_TOKENS_RC_LIMIT=1000
#
# LOCAL UI WORK ONLY — serves the fabricated Mock. NEVER set in production.
# REACT_APP_CREATOR_TOKENS_DEMO=1

# ─── FEED / MERITUM FEATURE FLAGS ────────────────────────────────────────────
# Added 2026-08-15. None of these were documented anywhere a deployer looks —
# not here, not in compose, not in CI — which meant the only way to learn a flag
# existed was to read the module that reads it. Two of them changed default
# behaviour on 2026-08-15 and an undocumented flag cannot be reasoned about.
#
# ALL OF THESE ARE OPT-IN. Unset means off. Set the literal string "yes".

# Rebuilds a returning reader's ranking in the background so their next load is
# instant. Adds outbound load to a public Hive node and to a rate-limited
# ranker that shares one client-address budget with real readers — which is why
# it is off unless you say otherwise.
# FEED_WARM_ENABLED=yes

# Warms the trending-topic caches on a timer. WAS ON BY DEFAULT until
# 2026-08-15 (it used to be disabled with `=off`); it is now opt-in like its
# sibling above. If an environment was relying on the old default, it must set
# this explicitly or it silently loses topic warming.
# FEED_TOPIC_WARM=yes

# ── SEEN-SUPPRESSION: two switches, and BOTH are required ────────────────────
# Stop showing a reader the same post over and over. It is deliberately split in
# two, and it was shipped with BOTH OFF — so the feature was built, containerised
# and "tested" while never once running for a real reader. Turned on 2026-08-15.
#
#   FEED_SEEN_RECORD (here)          fills `lumen_feed_seen` with what each
#                                    viewer was actually served.
#   RECSYS_SEEN_SUPPRESSION (ranker) makes the ranker act on that table. It is
#                                    set on the recsys container, not here, and
#                                    the image must actually CONTAIN the code —
#                                    recsys:latest predated it by a day.
#
# One without the other is a no-op: recording alone changes nothing a reader
# sees, and suppression alone reads an empty table.
#
# Requires migration 0036. With this unset, the serve path touches nothing 0036
# added and behaves exactly as it did before.
#
# HOW IT BEHAVES, measured on production 2026-08-15 (serves 65s apart):
#   serve 1  impressions=1, 0 posts at the threshold, 20/20 repeats
#   serve 2  impressions=2, 20 posts at the threshold, 20/20 repeats
#   serve 3  impressions=3, repeats fall to 7/20
# Two things follow. The rule needs TWO impressions, so nothing is suppressed on
# a second look — that is intended, not a fault. And repeat serves inside
# FEED_SERVED_MIN_INTERVAL_MS (default 60s) are COALESCED into one impression,
# so rapid reloads never accumulate; anyone testing this in a tight loop will
# conclude, wrongly, that it does not work.
FEED_SEEN_RECORD=yes

# How close together two serves may be and still count as one impression.
# Default 60000. Lower it only for testing.
# FEED_SERVED_MIN_INTERVAL_MS=60000

# The seen-suppression and band-scoring experiments.
# FEED_SEEN_RECORD=yes
# FEED_BANDS_ENABLED=yes

# How long the FIRST ranked build for a brand-new reader may block their request
# before falling back to trending. Default 12000 (2000 when the swap offer is
# on). A reader now pays this AT MOST ONCE: a later load arriving while that
# build is still running is served trending immediately instead of waiting again.
# FEED_FIRST_BUILD_PATIENCE_MS=12000
