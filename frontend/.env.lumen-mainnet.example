# ============================================================================
# Lumen — MAINNET environment template. Written 2026-08-06.
#
# Every variable the lite code actually reads, enumerated from source, not from
# memory (`grep -rhoE "process\.env\.(LITE_|DENSER_SERVER_SECRET|LUMEN_)"`).
# The old `.env.blog.example` carried ONE of these 38; a deploy built from it
# fails in ways that do not announce themselves.
#
# Marked:
#   [REQUIRED]   the app is broken or silently wrong without it
#   [REQUIRED*]  required only for the feature named
#   [OPTIONAL]   has a working default; listed so you can find it
#   [DANGER]     writes to a public permanent ledger, or is a raw key
#
# Copy to `apps/blog/.env.local` (Next reads it from disk — turbo's
# passThroughEnv allowlist silently drops shell exports, which has cost this
# project real debugging time twice).
# ============================================================================

# ---------------------------------------------------------------------------
# 1. THE THREE THAT BREAK HOUR ONE
# ---------------------------------------------------------------------------

# [REQUIRED] Without this EVERY lite login returns 500 with
# "iron-session: Bad usage. Missing password." It is not in the old runbook and
# it is the first thing that will go wrong. Any 32+ char secret.
#   openssl rand -base64 32
DENSER_SERVER_SECRET_COOKIE_PASSWORD=

# [REQUIRED] Nothing lite works at all without this.
LITE_ACCOUNTS_ENABLED=true

# [REQUIRED] Postgres for the lite schema (SEPARATE database from recsys).
# Apply all 21 migrations in apps/blog/lib/lite/db/migrations/ in filename order.
LITE_DATABASE_URL=postgresql://user:pass@host:5432/lumen_lite

# ---------------------------------------------------------------------------
# 2. PUBLISHING TO HIVE — read this section twice
#
# Without a working publisher, lite posts accumulate in Postgres, the author
# sees their post in Lumen, and NOTHING reports a problem. It is the single
# most silent failure mode in the feature.
# ---------------------------------------------------------------------------

# [REQUIRED] The Hive account lite posts are published under, per network.
# Only the one matching the app's chainEnv is used.
LITE_FRONTEND_ACCOUNT_MAINNET=
LITE_FRONTEND_ACCOUNT_MIRRORNET=
LITE_FRONTEND_ACCOUNT_TESTNET=

# [REQUIRED][DANGER] POSTING key of the account above. Not active, not owner.
# Proven at boot against the account's on-chain posting authority — a wrong or
# stale key fails loudly at startup rather than as a stream of rejections.
# If it ever leaks: one `account_update` rotating the posting authority revokes it.
LITE_PUBLISHER_POSTING_WIF=

# [REQUIRED IN PRODUCTION][DANGER] Nothing in this repo injects a KMS-backed
# broadcaster, so without this a production build has NO publisher at all and
# posts queue forever. Set to `yes` to run on the raw WIF above. Replace with a
# real signer via `setBroadcaster` before public launch.
LITE_PUBLISHER_ALLOW_WIF_IN_PROD=

# [REQUIRED FOR MAINNET][DANGER] Independent of the flag above, on purpose.
# That one asks "may this process hold a raw key?"; this one asks "may it write
# to the permanent public ledger?" Both must be set to publish to mainnet.
# Added after a real incident: an automated check hit the drain endpoint and
# broadcast a genuine comment to Hive mainnet.
LITE_PUBLISHER_ALLOW_MAINNET=

# [REQUIRED] Shared secret for POST /api/lite/publisher/drain. The scheduler in
# docker/lumen-publisher.yml calls it every 60s. Without it the publisher never runs.
LITE_PUBLISHER_TOKEN=

# [OPTIONAL] Drop the post body from Postgres once it is safely on Hive.
LITE_PRUNE_BODY_AFTER_PUBLISH=

# ---------------------------------------------------------------------------
# 3. MODERATION — your abuse plan depends on exactly one of these
# ---------------------------------------------------------------------------

# [REQUIRED] The ONLY authorisation for takedown/ban. `scripts/lumen-mod.sh`
# uses it. There is no admin account model — a shared operator secret is honest
# about that rather than inventing a half-role system.
LITE_MODERATOR_TOKEN=

# ---------------------------------------------------------------------------
# 4. CRYPTO KEYS — generate fresh per environment, never reuse
# ---------------------------------------------------------------------------

# [REQUIRED*] Google signup only. base64, EXACTLY 32 bytes. The code REFUSES to
# write an unkeyed email hash in production rather than silently dropping PII.
#   openssl rand -base64 32
LITE_EMAIL_ENCRYPTION_KEY=

# [REQUIRED*] Encrypts the key-reveal payload (browser-generated keys).
LITE_KEY_REVEAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 5. SIGNUP METHODS
#
# RECOMMENDATION FOR FIRST LAUNCH: leave Google unset. EVM signup is the path
# that has been driven end-to-end; Google carries a known open item (OAuth
# access + refresh tokens are returned to client JS with no session binding).
# Leaving this blank removes that exposure entirely.
# ---------------------------------------------------------------------------
LITE_GOOGLE_CLIENT_ID=
# The PUBLIC half. Google sign-in needs both: the server verifies with the one
# above, the browser mounts the button with this one, and the CSP grants
# accounts.google.com only when it sees this. Set both or neither — with only
# the server half the button renders permanently disabled.
REACT_APP_LITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# ★★★ CAPTCHA — BOTH OF THESE ARE MANDATORY IN PRODUCTION. NOT OPTIONAL.
#
# `assertLiteEnabled()` REFUSES to open signup when NODE_ENV=production and
# LITE_TURNSTILE_SECRET is unset, because the captcha check would otherwise fail
# OPEN and run public signup with no bot protection. Leaving these blank does
# not mean "no captcha" — it means NOBODY CAN SIGN UP, with a 503.
#
# Three ways to get this wrong, each failing somewhere different:
#   secret only    -> the browser renders no widget, sends no token: 403 on every
#                     signup ("captcha_failed").
#   site key only  -> signup refused outright: 503.
#   neither        -> signup refused outright: 503.
#
# Get a pair from Cloudflare Turnstile (free). For a staging box, Cloudflare's
# always-pass test keys work: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA — never on a public deploy.
#
# `scripts/lumen-preflight.sh` fails the deploy if these are not both set.
# ---------------------------------------------------------------------------
LITE_TURNSTILE_SECRET=
REACT_APP_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# 6. FULL-ACCOUNT UPGRADE (lite -> real Hive account)
#
# Leave the WIF unset to ship with upgrade disabled. This path has never
# broadcast a real transaction — do not enable it on mainnet until it has been
# driven once on a testnet.
# ---------------------------------------------------------------------------
LITE_ACCOUNT_CREATOR_ACCOUNT_MAINNET=
LITE_ACCOUNT_CREATOR_ACCOUNT_MIRRORNET=
LITE_ACCOUNT_CREATOR_ACCOUNT_TESTNET=
# [DANGER] ACTIVE authority — strictly more dangerous than the posting key above.
LITE_ACCOUNT_CREATOR_ACTIVE_WIF=
# [DANGER] Same shape as LITE_PUBLISHER_ALLOW_MAINNET, for account creation.
LITE_ACCOUNT_CREATOR_ALLOW_MAINNET=
LITE_ACCOUNT_CREATOR_TOKEN=
LITE_ACT_MIN_POOL=
LITE_ACT_SPEND_PER_DAY=
LITE_RC_FLOOR_PERCENT=

# ---------------------------------------------------------------------------
# 7. RECSYS — the ranked "For You" feed
#
# ★ WIRED 2026-08-06. Leave RECSYS_FEED_URL unset and "For You" serves Hive
# trending instead, honestly labelled in the response as `trending-fallback`.
# Set it and the feed becomes the ranking engine.
# ---------------------------------------------------------------------------

# [REQUIRED*] Base URL of the recsys service, reachable from the SERVER only
# (e.g. http://recsys-feed:8000 on the compose network). Never public: /feed
# returns any account's ranked feed plus its full score decomposition.
RECSYS_FEED_URL=

# [REQUIRED*][DANGER] Must equal recsys's own RECSYS_API_TOKEN. Server-side
# only — `lib/recsys/feed-client.ts` is `import 'server-only'` so a client
# bundle cannot pull it in.
RECSYS_API_TOKEN=

# [OPTIONAL] Per-request budget before falling back to trending. Default 4000ms.
# recsys refuses (503) on a stale trust snapshot and its cold warm-up was
# measured at ~232s; a reader must never wait for either.
RECSYS_FEED_TIMEOUT_MS=

# [REQUIRED*] Guards the endpoints recsys pulls FROM (follow-edges, resolve).
# Distinct from RECSYS_API_TOKEN — that one is Lumen calling recsys, this one is
# recsys calling Lumen.
LITE_RECSYS_TOKEN=

# ---------------------------------------------------------------------------
# 8. RATE LIMITS — all [OPTIONAL], all have working defaults.
#
# ★ THE VALUES BELOW ARE WRITTEN OUT, NOT LEFT BLANK, AND THAT IS DELIBERATE.
# They used to ship as bare `KEY=` lines under a comment promising you could
# "find them under load instead of grepping at 2am" — which you could not, because
# a blank tells you the name and nothing else. Every number here equals the code
# default, so copying this file changes no behaviour; it just means the ceiling
# you are about to hit is legible at 2am instead of buried in lib/lite/config.ts.
#
# Blank still means "use the code default". It does NOT mean zero.
# ---------------------------------------------------------------------------

# Per-IP, per-day. Signup is deliberately tight (an account is free, so this is
# the anti-Sybil arm); wallet challenge is deliberately loose (proving you own a
# wallet is cheap, repeated every login, and a shared office/mobile egress IP
# would otherwise lock out real users).
LITE_SIGNUP_PER_IP_PER_DAY=20
LITE_CHALLENGE_PER_IP_PER_DAY=200

# Platform-wide circuit breakers, not per-user quotas. Set well above organic
# volume — they exist to bound an attacker who rotates past the per-IP caps.
LITE_SIGNUP_GLOBAL_PER_DAY=5000
LITE_SIGNUP_ATTEMPT_GLOBAL_PER_DAY=50000

# ★ TWO SEPARATE READ BUDGETS. DO NOT MERGE THEM.
#
# LOOKUP is the SIGNUP FUNNEL: name availability, name suggestions, follow state.
# Low traffic, and load-bearing — if it runs out, nobody can choose a username.
#
# STREAK is the retention/league card (/api/streak/[user]), which fires on
# essentially every logged-in page load: one to two orders of magnitude more
# traffic than the entire signup funnel. It shared the LOOKUP budget until
# 2026-08-08, which meant existing users reading profiles would spend the whole
# 300 and then 429 the site's own name check — the site locking out its own
# signups after roughly 300 page views across ALL users. Two endpoints with
# different call rates must never share one counter.
#
# STREAK is the larger number and still the cheaper one: it meters only cache
# MISSES (warm reads never reach the limiter), and a miss is bounded by a 6s
# per-call timeout and a 20s whole-route budget.
LITE_LOOKUP_PER_IP_PER_DAY=300
LITE_STREAK_PER_IP_PER_DAY=1000

# Per-account, per-day. Uploads and edits are both signed by the SHARED publisher
# account, so abuse here spends our standing with the image host and our slice of
# Hive's ~20-broadcasts-per-minute budget — the cost does not land on the account
# causing it. That asymmetry is the entire reason these exist.
LITE_UPLOADS_PER_DAY=100
LITE_EDITS_PER_DAY=40
LITE_UPGRADE_ATTEMPTS_PER_DAY=30
LITE_HIVE_FOLLOWS_PER_DAY=300

LITE_MAX_UPLOAD_MB=8
LITE_CONTAINER_MAX_CHILDREN=1000
LITE_DB_POOL_MAX=10

# ★ [OPTIONAL BUT TOPOLOGY-CRITICAL] How many reverse proxies sit in front of the
# app. Same class of setting as recsys's RECSYS_TRUSTED_PROXY_HOPS.
#
# The client IP is read as the X-Forwarded-For entry THIS MANY HOPS FROM THE
# RIGHT — the value our own infrastructure appended, never the leftmost token,
# which any caller can forge. So this number must equal the real number of hops:
#   - too LOW  → you read a proxy's address instead of the client's, and every
#                client behind that proxy collapses into one bucket, so ONE
#                caller can exhaust a per-IP budget for everybody;
#   - too HIGH → you read into the client-supplied prefix, and a caller mints a
#                fresh bucket per request, defeating every per-IP limit at once.
#
# 1 is correct for a single edge (one Caddy, or scripts/lumen-https-front.mjs in
# QA), which is the common case. Count again after adding a CDN or a load
# balancer. The edge must also APPEND (or overwrite) X-Forwarded-For rather than
# relay the client's — see stack/Caddyfile and lumen-https-front.mjs.
LITE_TRUSTED_PROXY_COUNT=1
