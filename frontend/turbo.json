{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "REACT_APP_*",
        "DENSER_SERVER_*",
        "DENSER_URL",
        "NEXT_PUBLIC_*",
        "GOOGLE_DRIVE_*",
        "PUBLIC_HOSTNAME",
        "LOGGING_LOG_LEVEL",
        "BLOG_PORT"
      ]
    },
    "dev:3010": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "REACT_APP_*",
        "DENSER_SERVER_*",
        "DENSER_URL",
        "NEXT_PUBLIC_*",
        "GOOGLE_DRIVE_*",
        "PUBLIC_HOSTNAME",
        "LOGGING_LOG_LEVEL",
        "BLOG_PORT"
      ]
    },
    "devssl": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "REACT_APP_*",
        "DENSER_SERVER_*",
        "DENSER_URL",
        "NEXT_PUBLIC_*",
        "GOOGLE_DRIVE_*",
        "PUBLIC_HOSTNAME",
        "LOGGING_LOG_LEVEL",
        "BLOG_PORT"
      ]
    },
    "start": {
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx"
      ]
    },
    "test:jest": {},
    "pw:test:local": {},
    "pw:test:local:chromium": {},
    "pw:test:local:firefox": {},
    "pw:test:local:webkit": {},
    "pw:test:local:experimental:ui": {},
    "pw:blog:test:mir:chromium": {},
    "pw:blog:test:mir:chromium:trace": {},
    "pw:blog:test:mir:chromium:ui": {},
    "lint": {}
  }
}
