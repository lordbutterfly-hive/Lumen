{
  "extends": "@hive/tsconfig/base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/blog/*": [
        "./*"
      ],
      "@smart-signer/*": [
        "../../packages/smart-signer/*"
      ],
      "@transaction/*": [
        "../../packages/transaction/*"
      ],
      "@ui/*": [
        "../../packages/ui/*"
      ]
    },
    "module": "esnext",
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/ui/elements/common/layout.tsx",
    "../../packages/ui/components/time-ago.tsx",
    "../../packages/ui/components/card-skeleton.tsx",
    ".next*/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-probe/types/**/*.ts",
    ".next-qa-build/types/**/*.ts",
    ".next-qa-prev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright"
  ]
}
