# Lumen Lite accounts — local/dev env (copy to apps/blog/.env.local; .env.local is gitignored).
# turbo strict-env-mode strips undeclared vars, so these MUST live in .env.local (Next loads it directly).
LITE_ACCOUNTS_ENABLED=yes
LITE_DATABASE_URL=postgresql://lumen:lumen@localhost:5433/lumen
LITE_EMAIL_ENCRYPTION_KEY=   # base64, 32 bytes: openssl rand -base64 32
# Encrypts the reveal-once outbox that holds a freshly created Hive account's keys
# between "created on chain" and "the user confirmed they wrote them down".
# REQUIRED before /api/account/upgrade will run at all — the upgrade refuses to start
# rather than create an account whose keys it could not durably store. Separate key
# from the email one on purpose: leaking PII must not also unlock account keys.
LITE_KEY_REVEAL_ENCRYPTION_KEY=   # base64, 32 bytes: openssl rand -base64 32
LITE_KEY_REVEAL_TTL_HOURS=72      # how long unacknowledged keys stay stored (default 72)
LITE_GOOGLE_CLIENT_ID=       # real Google OAuth client id (…apps.googleusercontent.com) — required for Gmail login
LITE_FRONTEND_ACCOUNT_MAINNET=   # the proxy Hive account that broadcasts lite posts (keys live in KMS, not here)
LITE_FRONTEND_ACCOUNT_MIRRORNET=
LITE_FRONTEND_ACCOUNT_TESTNET=

# Reown/WalletConnect project id for the 1-click wallet connector (dashboard.reown.com).
# Client-side runtime env: read via env("REOWN_PROJECT_ID") from @beam-australia/react-env.
REACT_APP_REOWN_PROJECT_ID=

# Cloudflare Turnstile. BOTH must be set together, or neither:
#   REACT_APP_TURNSTILE_SITE_KEY — client widget (public)
#   LITE_TURNSTILE_SECRET        — server verification (secret)
# Server refuses to open public signup in production without the secret, and the
# client only renders the widget when the site key is present, so a half-configured
# deploy is impossible in either direction.
REACT_APP_TURNSTILE_SITE_KEY=
LITE_TURNSTILE_SECRET=

# Publisher pauses below this % of the account resource credits (durable queue,
# so this is a delay, not data loss). Default 10.
LITE_RC_FLOOR_PERCENT=10
# Set to yes ONLY to allow a non-production process to broadcast to Hive MAINNET.
LITE_PUBLISHER_ALLOW_MAINNET=

# Shared secret for POST /api/lite/publisher/drain. REQUIRED IN ANY REAL DEPLOY:
# without a scheduler calling that endpoint, lite posts stay in Postgres forever and
# nothing ever reaches Hive — silently, with no error shown to anyone. Pair it with
# scripts/lite-publisher-cron.sh on a every-minute cron.
LITE_PUBLISHER_TOKEN=

# Shared secret for the moderation endpoints (/api/lite/moderation/*). Empty means
# those endpoints are closed, which also means nobody can suspend an account or hide
# a post — set it before opening public signup. See scripts/lite-moderate.mjs.
LITE_MODERATOR_TOKEN=

# Shared secret for the recsys ingestion endpoints (/api/lite/recsys/*).
LITE_RECSYS_TOKEN=
